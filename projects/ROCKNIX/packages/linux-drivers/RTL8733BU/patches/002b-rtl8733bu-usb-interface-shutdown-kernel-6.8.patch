From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: ROCKNIX <build@rocknix.org>
Date: Wed, 1 Apr 2026 00:00:00 +0000
Subject: [PATCH] net: rtl8733bu: register shutdown via usb_driver.shutdown on 6.8+

Since Linux 6.8, struct usb_driver no longer embeds the old drvwrap layout;
usb_register_driver() always assigns device_driver.shutdown to
usb_shutdown_interface(), which in turn calls the USB driver's
usb_driver.shutdown(struct usb_interface *) hook if it is non-NULL.

The previous #else branch set .usbdrv.driver.shutdown = rtw_dev_shutdown.
That field is overwritten during usb_register_driver() and is the wrong
callback type (struct device * vs the USB core's wrapper), so on recent
kernels the Realtek teardown path in rtw_dev_shutdown() never ran during
system shutdown — the same gap addressed by the optional rtl8733bu-power
GPIO driver, but this fixes the in-driver path for plain 8733bu.

Add rtw_usb_intf_shutdown() that forwards to rtw_dev_shutdown(&intf->dev)
and assign .usbdrv.shutdown for LINUX_VERSION_CODE >= 6.8.0.

Signed-off-by: ROCKNIX <build@rocknix.org>
---
 os_dep/linux/usb_intf.c | 16 +++++++++++++++-
 1 file changed, 15 insertions(+), 1 deletion(-)

diff --git a/os_dep/linux/usb_intf.c b/os_dep/linux/usb_intf.c
index 1111111..2222222 100644
--- a/os_dep/linux/usb_intf.c
+++ b/os_dep/linux/usb_intf.c
@@ -98,6 +98,15 @@
 	}
 }
 
+#if LINUX_VERSION_CODE >= KERNEL_VERSION(6, 8, 0)
+/* usb_shutdown_interface() calls usb_driver->shutdown(intf); see usb_register_driver(). */
+static void rtw_usb_intf_shutdown(struct usb_interface *intf)
+{
+	if (intf)
+		rtw_dev_shutdown(&intf->dev);
+}
+#endif
+
 #if (LINUX_VERSION_CODE <= KERNEL_VERSION(2, 6, 23))
 /* Some useful macros to use to create struct usb_device_id */
 #define USB_DEVICE_ID_MATCH_VENDOR			 0x0001
@@ -359,7 +368,7 @@ struct rtw_usb_drv usb_drv = {
 #if LINUX_VERSION_CODE < KERNEL_VERSION(6, 8, 0)
     .usbdrv.drvwrap.driver.shutdown = rtw_dev_shutdown,
 #else
-	.usbdrv.driver.shutdown = rtw_dev_shutdown,
+	.usbdrv.shutdown = rtw_usb_intf_shutdown,
 #endif
 };
 
